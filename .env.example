# 複製這個檔案成 .env，填好之後重新啟動 server。
# .env 已被 .gitignore 排除，不會進版控。
#
# 全部留空也能正常運作：路線會自動使用 OSRM 公開伺服器（免金鑰、真實道路距離），
# 地圖使用 OpenStreetMap。以下設定都是「想升級時」才需要。

# ---- 方案 A：OpenRouteService（免費註冊，不需要信用卡）----
# https://openrouteservice.org/dev/#/signup 註冊後即可取得金鑰
# 優點：真的區分步行 / 自行車 / 汽車路網，每日 2000 次免費
ORS_API_KEY=

# ---- 方案 B：Google Maps Platform（需要計費帳戶）----
# 伺服器端金鑰：需啟用 Routes API，以「IP 位址」限制
GOOGLE_MAPS_API_KEY=

# 瀏覽器端金鑰：需啟用 Maps JavaScript API
# 這把一定會出現在網頁原始碼，務必以「HTTP 參照網址」限制網域
GOOGLE_MAPS_BROWSER_KEY=

# ---- 資料庫（正式環境務必設定）----
# 不設定的話會用本機 SQLite 檔。Render 免費方案的檔案系統是暫時的，
# 服務一休眠（閒置 15 分鐘）檔案就消失，使用者帳號與海龜進度會全部歸零。
# Turso 是 SQLite 相容的雲端資料庫，免費、不用信用卡。
# 建立方式見 README 的「資料庫」一節。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- 其他 ----
# 強制指定路線來源：google / ors / osrm / estimate（留空 = 自動選擇）
# ROUTING_PROVIDER=

# 自架 OSRM 時改這裡
# OSRM_BASE_URL=https://router.project-osrm.org

# 後端埠號（可省略，預設 4000）
# PORT=4000
